# ── База данных (Supabase/Neon даёт строку подключения Postgres) ───────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── LLM-провайдер (абстракция — можно сменить одной строкой) ───────────────
LLM_PROVIDER=anthropic
# По умолчанию claude-opus-4-8. Для дешёвых задач (категоризация) можно
# роутить на claude-haiku-4-5; для баланса цена/качество — claude-sonnet-4-6.
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe CONNECT — ЧТЕНИЕ данных клиента (read-only OAuth) ───────────────
# client_id из Dashboard → Connect → Settings (начинается с ca_...)
STRIPE_CLIENT_ID=ca_...
# Платёжный секретный ключ нашей платформы
STRIPE_SECRET_KEY=sk_test_...
STRIPE_CONNECT_REDIRECT_URI=https://your-domain.com/api/stripe/callback

# ── Stripe BILLING — приём оплаты ЗА нашу подписку (Фаза 2) ────────────────
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Шифрование хранимых токенов (32+ байта, hex) ──────────────────────────
# Сгенерировать: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_key

# ── Auth.js — секрет подписи сессий ───────────────────────────────────────
# Сгенерировать: openssl rand -base64 33
AUTH_SECRET=replace_with_random_secret

# ── Отправка писем — подтверждение email, отчёты, алерты ───────────────────
# Приоритет провайдеров: SendGrid → Resend → консоль (dev, если ключей нет).
# SendGrid: app.sendgrid.com → Settings → API Keys (нужен верифицированный домен
# в Sender Authentication). EMAIL_FROM должен быть на этом домене.
SENDGRID_API_KEY=SG....
EMAIL_FROM=Zori <noreply@zori.finance>
# Резервный провайдер (необязательно):
RESEND_API_KEY=re_...

# ── Google OAuth (вход через Google) ──────────────────────────────────────
# Google Cloud Console → Credentials → OAuth client ID (Web).
# Authorized redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Приложение ────────────────────────────────────────────────────────────
# Публичный URL приложения (для ссылок в письмах, редиректов Stripe/OAuth).
# Локально можно поставить http://localhost:3000, на проде — ваш домен.
APP_URL=https://your-domain.com

# ── Фоновый синк + алерты (cron) ──────────────────────────────────────────
# Секрет для защиты /api/cron/sync. Сгенерировать: openssl rand -hex 32
# На Vercel задаётся в env проекта — Vercel Cron сам шлёт его в Authorization.
CRON_SECRET=replace_with_random_secret

# ── Stripe Billing (наша подписка) ────────────────────────────────────────
# price ID из Stripe Dashboard → Products (создай тарифы Growth/Pro). Без них
# кнопки тарифов в Настройках показывают «Скоро».
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...
# whsec_... из Stripe Dashboard → Webhooks (endpoint /api/billing/webhook).
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Банки (GoCardless Bank Account Data, open banking ЕС, только чтение) ────
# Бесплатно: https://bankaccountdata.gocardless.com → User Secrets → создать
# Secret ID + Secret Key. Без них карточка «Банк» показывает «Скоро».
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Страна по умолчанию для списка банков (ISO-2: DE, FR, ES, NL, IT, …).
GOCARDLESS_COUNTRY=DE
STRIPE_PRICE_PLUS=price_...
AUTH_URL=http://localhost:3000

# Yapily (console.yapily.com) — подключение банков (open banking).
# Application UUID и Secret из раздела Applications; callback-URL
# ($APP_URL/api/bank/callback) должен быть добавлен в настройках приложения.
YAPILY_APPLICATION_UUID=
YAPILY_APPLICATION_SECRET=

# YAXI (yaxi.tech) — подключение банков через фронтовый флоу (routex-client).
# Key ID и Secret (base64) из консоли; YAXI_ENV: production | integration.
YAXI_KEY_ID=
YAXI_SECRET_KEY=
YAXI_ENV=production
